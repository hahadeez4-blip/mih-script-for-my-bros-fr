--// ACCELERATION EFFECT SETTINGS

local ACCEL_TRIGGER_ID   = "89772764055022"         
local ACCEL_DELAY        = 2.25                    
local ACCEL_DURATION     = 20                      
local ACCEL_ONESHOT_ID   = "rbxassetid://123559127105316" 
local ACCEL_WALKSPEED    = 7                       -- Lowered to 7 (was 85)
local ACCEL_TURN_SPEED   = 12                      
local ACCEL_MAX_DT       = 1/30                    
local ACCEL_RAMP_TIME    = 0.15                    

local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local accelActive = false 
local tpwalking = nil
local speed = 1

-- Cleanup tracking
local modelConnection = nil
local descendantConnection = nil
local characterDiedConnection = nil
local NewModelRef = nil
local scriptAlive = true


--// SHIFTLOCK HELPER

local function IsShiftlockActive()
	return UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
end



--// FIND PLAYER MODEL

local function FindOwnedModel()

	local Living = workspace:WaitForChild("Living")

	for _,model in ipairs(Living:GetChildren()) do

		for _,obj in ipairs(model:GetDescendants()) do

			if obj:IsA("ObjectValue") and obj.Name == "Owner" then

				if obj.Value == LocalPlayer 
				or (obj.Value and obj.Value.Name == LocalPlayer.Name) then

					return model

				end
			end
		end
	end

end


--// CHECK IF SOUND BELONGS TO LOCAL PLAYER / OWNED STAND
local function IsLocalSound(sound)
	if not sound or not sound:IsA("Sound") then
		return false
	end

	local character = LocalPlayer.Character
	if character and sound:IsDescendantOf(character) then
		return true
	end

	local ownedModel = FindOwnedModel()
	if ownedModel and sound:IsDescendantOf(ownedModel) then
		return true
	end

	return false
end



--// CREATE MODEL (C-MOON STYLE GROUP SYNC + TRANSPARENT OLD MODEL + MATCHED SIZES EXCEPT HEAD)

task.spawn(function()

	if not scriptAlive then return end

	local OldModel = FindOwnedModel()

	if not OldModel then
		warn("No owned model found")
		return
	end

	local assetPath = game:GetService("ReplicatedStorage").Assets.UltimateMiH
	local NewModel = assetPath:Clone()
	NewModelRef = NewModel


	-- REMOVE PARTS (MIH specific)
	local Remove = {
		{"LowerTorso","HorseL"},
		{"LowerTorso","HorseR"},
		{"Head","LHead"},
		{"Head","RHead"}
	}

	for _,data in ipairs(Remove) do

		local folder = NewModel:FindFirstChild(data[1])

		if folder then

			local part = folder:FindFirstChild(data[2])

			if part then
				part:Destroy()
			end

		end
	end


	-- AGGRESSIVE SCAN & DESTROY FOR ANY REMAINING RArm OR LArm
	for _, descendant in ipairs(NewModel:GetDescendants()) do
		local name = descendant.Name
		if name == "RArm" or name == "LArm" then
			descendant:Destroy()
		end
	end


	-- ANCHOR EVERYTHING IN NEW MODEL
	for _, obj in ipairs(NewModel:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.Massless = true
		end
	end


	-- MAKE OLD MODEL TRANSPARENT
	for _, obj in ipairs(OldModel:GetDescendants()) do
		if obj:IsA("BasePart")
			or obj:IsA("Decal")
			or obj:IsA("Texture") then

			obj.Transparency = 1

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail") then

			obj.Enabled = false

		end
	end


	-- MAKE NEW MODEL VISIBLE (NO TRANSPARENCY)
	for _, obj in ipairs(NewModel:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Transparency = 0
		elseif obj:IsA("Decal")
			or obj:IsA("Texture") then

			obj.Transparency = 0
		end
	end


	--// R15 BODY PARTS MAPPING FOR SIZING
	local BodyParts = {
		"HumanoidRootPart",
		"UpperTorso",
		"LowerTorso",
		"Head",
		"RightUpperArm",
		"RightLowerArm",
		"RightHand",
		"LeftUpperArm",
		"LeftLowerArm",
		"LeftHand",
		"RightUpperLeg",
		"RightLowerLeg",
		"RightFoot",
		"LeftUpperLeg",
		"LeftLowerLeg",
		"LeftFoot"
	}

	local function FindOldPart(name)
		local obj = OldModel:FindFirstChild(name, true)
		if obj and obj:IsA("BasePart") then
			return obj
		end
		return nil
	end

	local function FindNewGroup(name)
		local direct = NewModel:FindFirstChild(name)
		if direct then
			return direct
		end
		for _, obj in ipairs(NewModel:GetDescendants()) do
			if obj.Name == name then
				return obj
			end
		end
		return nil
	end

	local function GetGroupParts(group)
		local parts = {}
		if group:IsA("BasePart") then
			table.insert(parts, group)
		end
		for _, obj in ipairs(group:GetDescendants()) do
			if obj:IsA("BasePart") then
				table.insert(parts, obj)
			end
		end
		return parts
	end

	-- SCALE NEW MODEL PARTS TO MATCH OLD MODEL PART SIZES (EXCEPT HEAD)
	for _, BodyName in ipairs(BodyParts) do
		if BodyName ~= "Head" then
			local OldPart = FindOldPart(BodyName)
			local NewGroup = FindNewGroup(BodyName)

			if OldPart and NewGroup then
				local newParts = GetGroupParts(NewGroup)
				if #newParts > 0 then
					local referencePart = newParts[1]
					
					local oldSize = OldPart.Size
					local newSize = referencePart.Size
					
					local scaleX = oldSize.X / math.max(newSize.X, 0.001)
					local scaleY = oldSize.Y / math.max(newSize.Y, 0.001)
					local scaleZ = oldSize.Z / math.max(newSize.Z, 0.001)

					for _, part in ipairs(newParts) do
						part.Size = Vector3.new(part.Size.X * scaleX, part.Size.Y * scaleY, part.Size.Z * scaleZ)
						for _, child in ipairs(part:GetChildren()) do
							if child:IsA("SpecialMesh") then
								child.Scale = Vector3.new(child.Scale.X * scaleX, child.Scale.Y * scaleY, child.Scale.Z * scaleZ)
							end
						end
					end
				end
			end
		end
	end


	NewModel.Parent = workspace


	local OldRoot = FindOldPart("HumanoidRootPart")
	if not OldRoot then
		warn("MIH: Old model has no HumanoidRootPart.")
		NewModel:Destroy()
		return
	end

	local Groups = {}

	for _, BodyName in ipairs(BodyParts) do
		local OldPart = FindOldPart(BodyName)
		local NewGroup = FindNewGroup(BodyName)

		if OldPart and NewGroup then
			local Parts = GetGroupParts(NewGroup)

			if #Parts > 0 then
				local Reference = Parts[1]
				local Offsets = {}

				for _, Part in ipairs(Parts) do
					Offsets[Part] = Reference.CFrame:ToObjectSpace(Part.CFrame)
				end

				table.insert(Groups, {
					Name = BodyName,
					OldPart = OldPart,
					NewGroup = NewGroup,
					Reference = Reference,
					Parts = Parts,
					Offsets = Offsets
				})
			end
		end
	end

	NewModel:PivotTo(OldModel:GetPivot())

	modelConnection = RunService.RenderStepped:Connect(function()
		if not scriptAlive then
			if modelConnection then modelConnection:Disconnect() end
			return
		end

		if not OldModel or not OldModel.Parent then
			if modelConnection then modelConnection:Disconnect() end
			if NewModel then
				NewModel:Destroy()
			end
			return
		end

		if not NewModel or not NewModel.Parent then
			if modelConnection then modelConnection:Disconnect() end
			return
		end

		for _, Group in ipairs(Groups) do
			local OldPart = Group.OldPart
			local Reference = Group.Reference

			if OldPart and OldPart.Parent and Reference and Reference.Parent then
				local TargetCFrame = OldPart.CFrame
				Reference.CFrame = TargetCFrame

				for _, Part in ipairs(Group.Parts) do
					if Part and Part.Parent then
						local Offset = Group.Offsets[Part]
						if Offset then
							Part.CFrame = TargetCFrame * Offset
						end
					end
				end
			end
		end
	end)

end)



--// ACCELERATION EFFECT (TURNING & TPWALK ONLY)

local function DoAccelerationEffect()

	if not scriptAlive or accelActive then
		return
	end

	accelActive = true

	task.spawn(function()

		task.wait(ACCEL_DELAY)

		if not scriptAlive then
			accelActive = false
			return
		end

		local Character = LocalPlayer.Character

		if not Character then
			accelActive = false
			return
		end

		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
		local HRP = Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not HRP then
			accelActive = false
			return
		end


		local sfx = Instance.new("Sound")
		sfx.SoundId = ACCEL_ONESHOT_ID
		sfx.Parent = HRP
		sfx:Play()
		Debris:AddItem(sfx, 10)


		local originalWalkSpeed = Humanoid.WalkSpeed
		local originalJumpPower = Humanoid.JumpPower
		local originalAutoRotate = Humanoid.AutoRotate

		Humanoid.WalkSpeed = 0
		Humanoid.JumpPower = 0
		Humanoid.AutoRotate = false

		local function restoreHumanoid()
			if Humanoid and Humanoid.Parent then
				Humanoid.WalkSpeed = originalWalkSpeed
				Humanoid.JumpPower = originalJumpPower
				Humanoid.AutoRotate = originalAutoRotate
			end
		end


		local startTime = tick()
		speed = ACCEL_WALKSPEED

		pcall(function() if tpwalking then tpwalking:Disconnect() end end)
		tpwalking = RunService.Heartbeat:Connect(function(delta)
			if not scriptAlive then
				if tpwalking then tpwalking:Disconnect() end
				restoreHumanoid()
				accelActive = false
				return
			end

			delta = math.min(delta, ACCEL_MAX_DT)

			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart")

			if not (character and humanoid and hrp and humanoid.Parent) then 
				if tpwalking then tpwalking:Disconnect() end
				return 
			end

			local elapsed = tick() - startTime
			local remaining = ACCEL_DURATION - elapsed
			
			if elapsed >= ACCEL_DURATION or humanoid.Health <= 0 then
				if tpwalking then tpwalking:Disconnect() end
				restoreHumanoid()
				accelActive = false
				return
			end

			local rampMultiplier = 1
			if elapsed < ACCEL_RAMP_TIME then
				rampMultiplier = elapsed / ACCEL_RAMP_TIME
			elseif remaining < ACCEL_RAMP_TIME then
				rampMultiplier = remaining / ACCEL_RAMP_TIME
			end
			rampMultiplier = math.clamp(rampMultiplier, 0, 1)

			-- Smooth Facing / Turning logic
			local moveDir = humanoid.MoveDirection
			local currentLook = hrp.CFrame.LookVector
			local currentPos = hrp.Position
			local targetLook

			if IsShiftlockActive() then
				local camera = workspace.CurrentCamera
				local camLook = camera and Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z) or currentLook
				targetLook = camLook.Magnitude > 0.001 and camLook.Unit or currentLook
			elseif moveDir.Magnitude > 0 then
				targetLook = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
			else
				targetLook = currentLook
			end

			local alpha = math.clamp(ACCEL_TURN_SPEED * delta, 0, 1)
			local easedLook = currentLook:Lerp(targetLook, alpha)
			if easedLook.Magnitude < 0.001 then
				easedLook = targetLook
			end

			hrp.CFrame = CFrame.lookAt(currentPos, currentPos + easedLook)

			-- TPWalk Movement (now at speed 7)
			if moveDir.Magnitude > 0 then
				character:TranslateBy(moveDir * speed * rampMultiplier * delta * 10)
			end 
		end)

	end)

end



--// AUDIO SWAPPER

local function SwapSound(sound)

	if not scriptAlive or not sound:IsA("Sound") then
		return
	end

	local id = sound.SoundId:match("%d+")

	if AudioSwaps[id] then

		local data = AudioSwaps[id]
		local playing = sound.IsPlaying

		sound.SoundId = data.Id

		if playing then
			sound:Stop()
			sound.TimePosition = data.Start
			sound:Play()
		else
			sound.TimePosition = data.Start
		end

		-- Only trigger acceleration if this is a LOCAL sound (your character or your stand)
		if (id == "5968741444" or data.Id:match("%d+") == ACCEL_TRIGGER_ID) and IsLocalSound(sound) then

			sound.Played:Connect(function()
				if scriptAlive then
					DoAccelerationEffect()
				end
			end)

			if playing then
				DoAccelerationEffect()
			end

		end

	end

end



for _,obj in ipairs(game:GetDescendants()) do
	SwapSound(obj)
end


descendantConnection = game.DescendantAdded:Connect(function(obj)
	if not scriptAlive then return end
	task.defer(function()
		SwapSound(obj)
	end)
end)


--// GUI MOVESET

task.spawn(function()
	if not scriptAlive then return end

	local successGui, guiCore = pcall(function()
		return LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("GUIs"):WaitForChild("Core")
	end)

	if not successGui or not guiCore then
		return
	end

	local TARGET_IMAGE = "rbxassetid://5601244863"

	local function setupMove(buttonName, defaultText)
		local success, button = pcall(function()
			return guiCore:WaitForChild(buttonName, 5)
		end)

		if not success or not button then
			return
		end

		local imageLabel = button:WaitForChild("ImageLabel")

		imageLabel.Image = TARGET_IMAGE
		imageLabel.ImageTransparency = 0

		button.Text = defaultText

		local function isValidText(txt)
			if txt == defaultText then
				return true
			end

			local num = tonumber(txt)
			if num and num >= 0.1 and num <= 30 then
				return true
			end

			return false
		end

		button:GetPropertyChangedSignal("Text"):Connect(function()
			local currentText = button.Text
			if not isValidText(currentText) then
				button.Text = defaultText
			end
		end)

		imageLabel:GetPropertyChangedSignal("Image"):Connect(function()
			if imageLabel.Image ~= TARGET_IMAGE then
				imageLabel.Image = TARGET_IMAGE
			end
		end)

		imageLabel:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
			if imageLabel.ImageTransparency ~= 0 then
				imageLabel.ImageTransparency = 0
			end
		end)
	end

	setupMove("Super1", "Knifes")
	setupMove("Super2", "You Thought!")
	setupMove("Super3", "Jotaro Kujo Your Only Weakness Is Your Daughter...")
	setupMove("Ultimate", "Universe Reset")
	setupMove("Rush", "Too late")
	setupMove("Heavy", "Goodbye!")
end)


--// CLEANUP ON DEATH
local function CleanupScript()
	if not scriptAlive then return end
	scriptAlive = false

	-- Stop acceleration
	accelActive = false
	if tpwalking then
		pcall(function() tpwalking:Disconnect() end)
		tpwalking = nil
	end

	-- Disconnect model sync
	if modelConnection then
		pcall(function() modelConnection:Disconnect() end)
		modelConnection = nil
	end

	-- Disconnect sound listener
	if descendantConnection then
		pcall(function() descendantConnection:Disconnect() end)
		descendantConnection = nil
	end

	-- Destroy custom model
	if NewModelRef and NewModelRef.Parent then
		pcall(function() NewModelRef:Destroy() end)
		NewModelRef = nil
	end

	-- Disconnect death connection
	if characterDiedConnection then
		pcall(function() characterDiedConnection:Disconnect() end)
		characterDiedConnection = nil
	end

	print("MIH Script cleaned up on death.")
end

-- Hook into character death
local function SetupDeathHandler(character)
	if not character then return end

	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		characterDiedConnection = humanoid.Died:Connect(function()
			CleanupScript()
		end)
	end
end

if LocalPlayer.Character then
	SetupDeathHandler(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(character)
	-- If the script is still considered alive when a new character spawns, re-setup
	-- (in most cases after death we already cleaned up, so this mainly handles respawn if you re-execute)
	if scriptAlive then
		SetupDeathHandler(character)
	end
end)
