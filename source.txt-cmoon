--//========================================================
--// CONFIGURATION
--//========================================================

local SCRIPT_MODE = "cmoon"


--//========================================================
--// NOTIFICATION
--//========================================================

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Notification",
    Text = "Thanks For Using C-Moon Script By Luis :)",
    Icon = "rbxassetid://242239336"
})


--//========================================================
--// AUDIO SWAPS
--//========================================================

local AudioSwaps = {
    -- ["ORIGINAL_ID"] = {
    --  Id = "rbxassetid://NEW_ID",
    --  Start = 0
    -- }
}


--//========================================================
--// SERVICES
--//========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer


--//========================================================
--// FIND OWNED MODEL
--//========================================================

local function FindOwnedModel()

    local Living = workspace:WaitForChild("Living")

    for _, model in ipairs(Living:GetChildren()) do

        for _, obj in ipairs(model:GetDescendants()) do

            if obj:IsA("ObjectValue") and obj.Name == "Owner" then

                if obj.Value == Player
                    or (obj.Value and obj.Value.Name == Player.Name) then

                    return model
                end
            end
        end
    end

    return nil
end


--//========================================================
--// C-MOON
--//========================================================

task.spawn(function()

    local OldModel = FindOwnedModel()

    if not OldModel then
        warn("C-Moon: No owned model found.")
        return
    end


    local Assets = ReplicatedStorage:WaitForChild("Assets")
    local CmoonAsset = Assets:WaitForChild("UltimateCMoon")

    local NewModel = CmoonAsset:Clone()


    --//====================================================
    --// REMOVE UNWANTED PARTS
    --//====================================================

    local Remove = {
        {"Head", "LHead"},
        {"Head", "RHead"},
        {"RightUpperArm", "RArm"},
        {"LeftUpperArm", "LArm"}
    }


    for _, data in ipairs(Remove) do

        local folder = NewModel:FindFirstChild(data[1])

        if folder then

            local part = folder:FindFirstChild(data[2])

            if part then
                part:Destroy()
            end

        end
    end


    --// Remove any remaining RArm/LArm
    local RemoveList = {}

    for _, obj in ipairs(NewModel:GetDescendants()) do

        if obj.Name == "RArm"
            or obj.Name == "LArm" then

            table.insert(RemoveList, obj)

        end
    end


    for _, obj in ipairs(RemoveList) do

        if obj.Parent then
            obj:Destroy()
        end
    end


    --//====================================================
    --// PARENT
    --//====================================================

    NewModel.Parent = workspace


    --//====================================================
    --// IMPORTANT:
    --// ANCHOR EVERYTHING
    --//
    --// C-Moon is a visual replacement.
    --// We don't want physics pulling its pieces apart.
    --//====================================================

    for _, obj in ipairs(NewModel:GetDescendants()) do

        if obj:IsA("BasePart") then

            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Massless = true

        end
    end


    --//====================================================
    --// MAKE OLD MODEL INVISIBLE
    --//====================================================

    for _, obj in ipairs(OldModel:GetDescendants()) do

        if obj:IsA("BasePart")
            or obj:IsA("Decal")
            or obj:IsA("Texture") then

            obj.Transparency = 1

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail") then

            obj.Enabled = false

        end
    end


    --//====================================================
    --// MAKE C-MOON VISIBLE (WITH HRP TRANSPARENT)
    --//====================================================

    for _, obj in ipairs(NewModel:GetDescendants()) do

        if obj:IsA("BasePart") then

            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                obj.Transparency = 0
            end

        elseif obj:IsA("Decal")
            or obj:IsA("Texture") then

            obj.Transparency = 0

        end
    end


    --//========================================================
    --// R15 BODY PARTS
    --//========================================================

    local BodyParts = {
        "HumanoidRootPart",

        "UpperTorso",
        "LowerTorso",

        "Head",

        "RightUpperArm",
        "RightLowerArm",
        "RightHand",

        "LeftUpperArm",
        "LeftLowerArm",
        "LeftHand",

        "RightUpperLeg",
        "RightLowerLeg",
        "RightFoot",

        "LeftUpperLeg",
        "LeftLowerLeg",
        "LeftFoot"
    }


    --//========================================================
    --// FIND OLD BODY PART
    --//========================================================

    local function FindOldPart(name)

        local obj = OldModel:FindFirstChild(name, true)

        if obj and obj:IsA("BasePart") then
            return obj
        end

        return nil
    end


    --//========================================================
    --// FIND C-MOON GROUP
    --//========================================================

    local function FindNewGroup(name)

        local direct = NewModel:FindFirstChild(name)

        if direct then
            return direct
        end


        for _, obj in ipairs(NewModel:GetDescendants()) do

            if obj.Name == name then
                return obj
            end

        end


        return nil
    end


    --//========================================================
    --// GET GROUP PARTS
    --//========================================================

    local function GetGroupParts(group)

        local parts = {}


        if group:IsA("BasePart") then
            table.insert(parts, group)
        end


        for _, obj in ipairs(group:GetDescendants()) do

            if obj:IsA("BasePart") then
                table.insert(parts, obj)
            end

        end


        return parts
    end


    --//========================================================
    --// FIND ROOT
    --//========================================================

    local OldRoot = FindOldPart("HumanoidRootPart")

    if not OldRoot then

        warn(
            "C-Moon: Old model has no HumanoidRootPart."
        )

        NewModel:Destroy()

        return
    end


    --//========================================================
    --// SAVE C-MOON INITIAL BODY POSITIONS
    --//========================================================

    local Groups = {}


    for _, BodyName in ipairs(BodyParts) do

        local OldPart = FindOldPart(BodyName)
        local NewGroup = FindNewGroup(BodyName)


        if OldPart and NewGroup then

            local Parts = GetGroupParts(NewGroup)


            if #Parts > 0 then

                -- First C-Moon part is the group's reference.
                local Reference = Parts[1]

                local Offsets = {}


                -- Save every piece's ORIGINAL position
                -- relative to the reference.
                for _, Part in ipairs(Parts) do

                    Offsets[Part] =
                        Reference.CFrame:ToObjectSpace(
                            Part.CFrame
                        )

                end


                -- Save the reference's original relationship
                -- to the C-Moon model.
                local RootOffset =
                    NewModel:GetPivot():ToObjectSpace(
                        Reference.CFrame
                    )


                table.insert(Groups, {

                    Name = BodyName,

                    OldPart = OldPart,

                    NewGroup = NewGroup,

                    Reference = Reference,

                    Parts = Parts,

                    Offsets = Offsets,

                    RootOffset = RootOffset

                })

            end
        end
    end


    --//========================================================
    --// INITIAL C-MOON POSITION
    --//========================================================

    NewModel:PivotTo(OldModel:GetPivot())


    --//========================================================
    --// BODY SYNC
    --//========================================================
    --
    -- OLD R15:
    --
    -- HumanoidRootPart
    --       ↓
    --     Head
    --     Torso
    --     Arms
    --     Legs
    --
    -- Each C-Moon group follows the corresponding OLD R15
    -- body part while preserving its own geometry.
    --
    --========================================================

    local Connection

    Connection = RunService.RenderStepped:Connect(function()

        if not OldModel
            or not OldModel.Parent then

            Connection:Disconnect()

            if NewModel then
                NewModel:Destroy()
            end

            return
        end


        if not NewModel
            or not NewModel.Parent then

            Connection:Disconnect()

            return
        end


        --====================================================
        -- SYNC EVERY BODY GROUP
        --====================================================

        for _, Group in ipairs(Groups) do

            local OldPart = Group.OldPart
            local Reference = Group.Reference


            if OldPart
                and OldPart.Parent
                and Reference
                and Reference.Parent then


                --================================================
                -- GET OLD LIMB'S WORLD CFRAME
                --================================================

                local TargetCFrame =
                    OldPart.CFrame


                --================================================
                -- MOVE C-MOON REFERENCE
                --================================================

                Reference.CFrame =
                    TargetCFrame


                --================================================
                -- RESTORE ALL C-MOON PIECES
                --================================================

                for _, Part in ipairs(Group.Parts) do

                    if Part
                        and Part.Parent then

                        local Offset =
                            Group.Offsets[Part]


                        if Offset then

                            Part.CFrame =
                                TargetCFrame * Offset

                        end
                    end
                end
            end
        end

    end)


    --//========================================================
    --// AUDIO SWAPPER
    --//========================================================

    local function SwapSound(sound)

        if not sound:IsA("Sound") then
            return
        end


        local id = sound.SoundId:match("%d+")


        if id and AudioSwaps[id] then

            local data = AudioSwaps[id]

            local wasPlaying =
                sound.IsPlaying


            sound.SoundId =
                data.Id


            if wasPlaying then

                sound:Stop()

                sound.TimePosition =
                    data.Start or 0

                sound:Play()

            else

                sound.TimePosition =
                    data.Start or 0

            end
        end
    end


    -- Existing sounds
    for _, obj in ipairs(game:GetDescendants()) do
        SwapSound(obj)
    end


    -- New sounds
    game.DescendantAdded:Connect(function(obj)

        task.defer(function()
            SwapSound(obj)
        end)

    end)


    --//========================================================
    --// GUI MOVESET
    --//========================================================

    local guiCore = Player
        :WaitForChild("PlayerGui")
        :WaitForChild("GUIs")
        :WaitForChild("Core")


    local TARGET_IMAGE =
        "rbxassetid://71216859091308"


    local function setupMove(buttonName, defaultText)

        local button =
            guiCore:WaitForChild(buttonName)

        local imageLabel =
            button:WaitForChild("ImageLabel")


        imageLabel.Image =
            TARGET_IMAGE

        imageLabel.ImageTransparency = 0


        button.Text =
            defaultText


        local function isValidText(txt)

            if txt == defaultText then
                return true
            end


            local num =
                tonumber(txt)


            if num
                and num >= 0.1
                and num <= 30 then

                return true
            end


            return false
        end


        button:GetPropertyChangedSignal(
            "Text"
        ):Connect(function()

            local currentText =
                button.Text


            if not isValidText(currentText) then

                button.Text =
                    defaultText

            end

        end)


        imageLabel:GetPropertyChangedSignal(
            "Image"
        ):Connect(function()

            if imageLabel.Image ~= TARGET_IMAGE then

                imageLabel.Image =
                    TARGET_IMAGE

            end

        end)


        imageLabel:GetPropertyChangedSignal(
            "ImageTransparency"
        ):Connect(function()

            if imageLabel.ImageTransparency ~= 0 then

                imageLabel.ImageTransparency = 0

            end

        end)

    end


    --//========================================================
    --// MOVESET
    --//========================================================

    setupMove(
        "Super1",
        "Rock Debris"
    )

    setupMove(
        "Super2",
        "Counter"
    )

    setupMove(
        "Super3",
        "Ill will finish this"
    )

    setupMove(
        "Ultimate",
        "Gravitational Shift"
    )

    setupMove(
        "Rush",
        "Ushaaa!"
    )

    setupMove(
        "Heavy",
        "I am the center of gravity..."
    )


    print(
        "C-Moon loaded. Synced",
        #Groups,
        "R15 body groups."
    )

end)
