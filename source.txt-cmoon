--// CONFIGURATION
local SCRIPT_MODE = "cmoon" -- Set to "C-Moon"

--// NOTIFICATION
game:GetService("StarterGui"):SetCore("SendNotification",{
	Title = "Notification",
	Text = "Thanks For Using C-Moon Script By Luis :)",
	Icon = "rbxassetid://242239336"
})

--// SETTINGS (Add your C-Moon custom audio swaps here later)
local AudioSwaps = {
	-- Example format:
	-- ["ORIGINAL_ID"] = { Id = "rbxassetid://NEW_ID", Start = 0 }
}


local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")


--// FIND PLAYER MODEL

local function FindOwnedModel()

	local Living = workspace:WaitForChild("Living")
	local Player = game.Players.LocalPlayer

	for _,model in ipairs(Living:GetChildren()) do

		for _,obj in ipairs(model:GetDescendants()) do

			if obj:IsA("ObjectValue") and obj.Name == "Owner" then

				if obj.Value == Player 
				or (obj.Value and obj.Value.Name == Player.Name) then

					return model

				end
			end
		end
	end

end



--// CREATE MODEL

task.spawn(function()

	local OldModel = FindOwnedModel()

	if not OldModel then
		warn("No owned model found")
		return
	end

	local assetPath = game:GetService("ReplicatedStorage").Assets.UltimateCMoon
	local NewModel = assetPath:Clone()


	-- REMOVE PARTS (C-Moon specific)
	local Remove = {
		{"Head","LHead"},
		{"Head","RHead"},
		{"RightUpperArm","RArm"},
		{"LeftUpperArm","LArm"}
	}

	for _,data in ipairs(Remove) do

		local folder = NewModel:FindFirstChild(data[1])

		if folder then

			local part = folder:FindFirstChild(data[2])

			if part then
				part:Destroy()
			end

		end
	end


	-- AGGRESSIVE SCAN & DESTROY FOR ANY REMAINING RArm OR LArm
	for _, descendant in ipairs(NewModel:GetDescendants()) do
		local name = descendant.Name
		if name == "RArm" or name == "LArm" then
			descendant:Destroy()
		end
	end


	NewModel.Parent = workspace
	NewModel:PivotTo(OldModel:GetPivot())


	-- UNANCHOR ALL PARTS IN NEW MODEL
	for _, v in ipairs(NewModel:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = false
		end
	end


	-- DISABLE OLD MODEL EXTRAS
	for _,v in ipairs(OldModel:GetDescendants()) do
		if v:IsA("Decal") or v:IsA("Texture") then
			v.Transparency = 1
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
			v.Enabled = false
		end
	end


	-- WELD & SETUP LIVE TRANSPARENCY SYNC (Inverse: Old >= 0.5 -> New = 0, else New = 1)

	local transparencyPairs = {}

	for _,newPart in ipairs(NewModel:GetDescendants()) do

		if newPart:IsA("BasePart") then

			local oldPart = OldModel:FindFirstChild(newPart.Name,true)

			if oldPart and oldPart:IsA("BasePart") then

				newPart.Anchored = false
				newPart.CanCollide = false
				newPart.Massless = true

				newPart.CFrame = oldPart.CFrame


				local weld = Instance.new("WeldConstraint")
				weld.Part0 = oldPart
				weld.Part1 = newPart
				weld.Parent = newPart

				table.insert(transparencyPairs, {Old = oldPart, New = newPart})

			end
		end
	end

	RunService.RenderStepped:Connect(function()
		for _, pair in ipairs(transparencyPairs) do
			if pair.Old and pair.Old.Parent and pair.New and pair.New.Parent then
				local oldAlpha = pair.Old.Transparency
				if oldAlpha >= 0.5 then
					pair.New.Transparency = 0
				else
					pair.New.Transparency = 1
				end
			end
		end
	end)



	--// ANIMATION SYNC

	local function GetSpecificAnimator(model)
		local controller = model:FindFirstChild("AnimationController")
		if controller and controller:IsA("AnimationController") then
			local animator = controller:FindFirstChild("Animator")
			if animator and animator:IsA("Animator") then
				return animator
			else
				local newAnimator = Instance.new("Animator")
				newAnimator.Name = "Animator"
				newAnimator.Parent = controller
				return newAnimator
			end
		else
			local newController = Instance.new("AnimationController")
			newController.Name = "AnimationController"
			newController.Parent = model
			local newAnimator = Instance.new("Animator")
			newAnimator.Name = "Animator"
			newAnimator.Parent = newController
			return newAnimator
		end
	end

	local OldAnimator = GetSpecificAnimator(OldModel)
	local NewAnimator = GetSpecificAnimator(NewModel)

	if OldAnimator and NewAnimator then
		print("Unfrozen live animation syncing enabled for: " .. OldModel.Name)

		local activeMirrorConns = {}

		local function MirrorTrack(oldTrack)
			local oldAnimation = oldTrack.Animation
			if oldAnimation then
				local newAnimation = Instance.new("Animation")
				newAnimation.AnimationId = oldAnimation.AnimationId

				local success, newTrack = pcall(function()
					return NewAnimator:LoadAnimation(newAnimation)
				end)

				if success and newTrack then
					newTrack.Priority = oldTrack.Priority
					newTrack.Looped = oldTrack.Looped

					newTrack:Play(0, oldTrack.WeightCurrent, 0)

					local conn
					conn = RunService.RenderStepped:Connect(function()
						if not oldTrack.IsPlaying or not newTrack.IsPlaying or not oldTrack.Parent or not newTrack.Parent then
							conn:Disconnect()
							pcall(function() newTrack:Stop() end)
							return
						end
						newTrack.TimePosition = oldTrack.TimePosition
						newTrack:AdjustWeight(oldTrack.WeightCurrent, 0)
					end)
					table.insert(activeMirrorConns, conn)
				end
			end
		end

		for _, activeTrack in ipairs(OldAnimator:GetPlayingAnimationTracks()) do
			task.spawn(function()
				MirrorTrack(activeTrack)
			end)
		end

		OldAnimator.AnimationPlayed:Connect(function(oldTrack)
			MirrorTrack(oldTrack)
		end)
	else
		warn("Old or New animator could not be found or created")
	end

end)



--// AUDIO SWAPPER

local function SwapSound(sound)

	if not sound:IsA("Sound") then
		return
	end

	local id = sound.SoundId:match("%d+")

	if AudioSwaps[id] then
		local data = AudioSwaps[id]
		local playing = sound.IsPlaying

		sound.SoundId = data.Id

		if playing then
			sound:Stop()
			sound.TimePosition = data.Start
			sound:Play()
		else
			sound.TimePosition = data.Start
		end
	end

end



for _,obj in ipairs(game:GetDescendants()) do
	SwapSound(obj)
end


game.DescendantAdded:Connect(function(obj)

	task.defer(function()
		SwapSound(obj)
	end)

end)
